{
  "name": "Rahyab Web Prototype",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Rahyab preview",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python3 -m http.server 8000 >/tmp/rahyab-preview.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.live-server"
      ]
    }
  }
}